db = db.getSiblingDB("universidad_db");

// -----------------------------------------------------------------------------
// 1. COLECCIÓN: estudiantes
// Unifica la tabla 'estudiante', 'preferencias' (JSON) y 'estudiante_interes'
// -----------------------------------------------------------------------------
db.createCollection("estudiantes", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["nombre", "apellido", "correo", "carrera", "semestre"],
      properties: {
        nombre: { bsonType: "string" },
        apellido: { bsonType: "string" },
        correo: { bsonType: "string", pattern: "^.+@.+$" },
        carrera: { bsonType: "string" },
        
        semestre: { bsonType: "int", minimum: 1, maximum: 12 },
        fecha_registro: { bsonType: "date" },
        
        preferencias: { bsonType: "object" },
        
        intereses_ids: { bsonType: "array", items: { bsonType: "objectId" } }
      }
    }
  }
});

db.estudiantes.createIndex({ correo: 1 }, { unique: true });


